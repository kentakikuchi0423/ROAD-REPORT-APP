# このファイルは .dev.vars のテンプレートです。
# 実際の値を記入したファイルを .dev.vars として保存してください。
# .dev.vars は .gitignore に含まれており、リポジトリには含まれません。

# LINE Messaging API（LINE Developers Console で取得）
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 管理画面認証
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_sha256_hash_here   # echo -n "yourpassword" | sha256sum
ADMIN_SESSION_SECRET=your_random_secret_here # openssl rand -hex 32

# Cloudflare（ローカル開発では不要。wrangler が自動で認証する）
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
